        <!-- resource_manager -->
        <mxCell id="fn-rm" value="resource_manager&#xa;─────────────────&#xa;POST /resources&#xa;GET  /resources&#xa;PUT  /resources/{id}&#xa;DEL  /resources/{id}&#xa;─────────────────&#xa;Validates: title, url, type&#xa;HTTP 400 missing fields&#xa;HTTP 403 ownership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#cc5500;fontColor=#ffffff;fontSize=9;fontStyle=0;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
