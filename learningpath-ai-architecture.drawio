        </mxCell>

        <!-- career_goal_manager -->
        <mxCell id="fn-cg" value="career_goal_manager&#xa;─────────────────&#xa;POST /career-goal&#xa;PUT  /career-goal&#xa;─────────────────&#xa;Validates: skillLevel enum&#xa;weeklyHours 1–168&#xa;pace: Slow/Moderate/Fast&#xa;careerGoal ≤ 200 chars&#xa;Triggers AI Planner on save" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#cc5500;fontColor=#ffffff;fontSize=9;fontStyle=0;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="480" y="255" width="195" height="210" as="geometry"/>
        </mxCell>

        <!-- ai_planner -->
        <mxCell id="fn-ap" value="ai_planner&#xa;─────────────────&#xa;POST /learning-plan&#xa;─────────────────&#xa;Bedrock plan generation&#xa;60s timeout · 503 on error&#xa;7+ day daily schedule&#xa;Assigns priorityScore 0–100&#xa;Excludes: Completed / Skipped&#xa;Preserves last plan on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#cc5500;fontColor=#ffffff;fontSize=9;fontStyle=0;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="255" width="195" height="210" as="geometry"/>
        </mxCell>

        <!-- dashboard_api -->
        <mxCell id="fn-db" value="dashboard_api&#xa;─────────────────&#xa;GET /dashboard&#xa;─────────────────&#xa;Aggregated response ≤ 3s&#xa;Today task · completion %&#xa;Study streak · weekly progress&#xa;Priority resources · roadmap&#xa;Certifications · projects&#xa;null fields if no active plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#cc5500;fontColor=#ffffff;fontSize=9;fontStyle=0;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="255" width="195" height="210" as="geometry"/>
        </mxCell>

        <!-- progress_tracker -->
