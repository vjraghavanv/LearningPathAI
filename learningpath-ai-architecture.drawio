        <mxCell id="cw-detail" value="Structured JSON logs per invocation: userId · path · statusCode · durationMs · correlationId&#xa;Error log fields: errorType · sanitized errorMessage · correlationId&#xa;Dashboard metrics: Lambda invocations · error rate · P95 duration · API GW 4xx/5xx · DDB RCU/WCU&#xa;Alarm: Lambda error rate &gt; 5% over 5-min window → SNS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="140" y="798" width="690" height="100" as="geometry"/>
