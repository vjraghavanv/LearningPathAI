        <mxCell id="row4-iac-bg" value="⑥ Infrastructure as Code — AWS CDK (Python)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=10;fontStyle=1;fontColor=#444444;strokeColor=#888888;fillColor=#f5f5f5;rounded=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
