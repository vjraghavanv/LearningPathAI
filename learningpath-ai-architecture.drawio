        </mxCell>

        <!-- ai_analyzer -->
        <mxCell id="fn-aa" value="ai_analyzer&#xa;─────────────────&#xa;POST /analyze&#xa;─────────────────&#xa;Invoked after resource save&#xa;Bedrock Nova Lite enrichment&#xa;Extracts: priority, summary,&#xa;skills, difficulty, estimatedTime&#xa;whyLearnNow, recommendedWeek&#xa;30s timeout · null-safe on error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=#cc5500;fontColor=#ffffff;fontSize=9;fontStyle=0;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
